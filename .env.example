# ==============================================================================
# DAILY MEAT BACKEND - ENVIRONMENT VARIABLE DEFINITIONS & DOCUMENTATION (.env.example)
# ==============================================================================
# This section defines what every environment variable is used for in this project:
#
# 1. SERVER & NETWORK
#    - PORT: Port where Express HTTP & Socket.IO server listens (default: 5000).
#    - APP_BASE_URL: Public domain of the backend used for CORS, payment callbacks, webhooks.
#
# 2. DATABASE (PostgreSQL / Supabase)
#    - DATABASE_URL: PostgreSQL connection URI (uses Supabase connection pooler on port 6543).
#
# 3. CASHFREE PAYMENT GATEWAY
#    - CASHFREE_ENV: Environment mode ('PROD' for live payments, 'TEST' for sandbox).
#    - CASHFREE_APP_ID: Merchant Application ID from Cashfree merchant dashboard.
#    - CASHFREE_SECRET_KEY: Merchant Secret Key used to generate payment sessions & verify webhooks.
#
# 4. AUTHENTICATION & JWT SECRETS
#    - JWT_SECRET: Secret key to sign & verify short-lived access tokens across API & WebSockets.
#    - JWT_EXPIRES_IN: Access token expiry duration (e.g. 50d).
#    - REFRESH_TOKEN_SECRET: Secret key to sign & verify long-lived refresh tokens.
#    - REFRESH_TOKEN_EXPIRES_IN: Refresh token expiry duration (e.g. 50d).
#
# 5. PUSH NOTIFICATIONS (Firebase & Expo)
#    - FIREBASE_SERVICE_ACCOUNT_BASE64: Base64-encoded Firebase Admin service account JSON for FCM alerts.
#
# 6. TRANSACTIONAL EMAIL (Zoho SMTP)
#    - SMTP_HOST: Outgoing mail server (smtp.zoho.in).
#    - SMTP_PORT: Secure SSL mail port (465).
#    - SMTP_USER: Sender email username (noreply@dailymeat.in).
#    - SMTP_PASS: Zoho SMTP password / app password.
#    - SMTP_FROM: Display name and sender address on customer receipts.
#
# 7. SMS FORTIUS GATEWAY (OTP & Transactional SMS)
#    - SMS_FORTIUS_API_KEY: Authentication key for SMS Fortius HTTP API.
#    - SMS_FORTIUS_SENDER_ID: 6-letter approved DLT sender header (DMMEAT).
#    - SMS_FORTIUS_TEMPLATE_ID: Government-approved DLT content template ID for OTPs.
#    - SMS_FORTIUS_BASE_URL: HTTP endpoint to trigger SMS dispatch.
#
# 8. ASSET STORAGE PROVIDER (Supabase S3 / Cloudinary)
#    - STORAGE_PROVIDER: Active storage driver ('s3' or 'cloudinary').
#    - AWS_REGION: Data center region (ap-southeast-1 for Supabase Singapore).
#    - AWS_ENDPOINT: S3-compatible API endpoint URL for Supabase Storage.
#    - AWS_ACCESS_KEY_ID: S3 Access Key ID created in Supabase Dashboard -> Storage.
#    - AWS_SECRET_ACCESS_KEY: S3 Secret Access Key corresponding to the Access Key ID.
#    - AWS_S3_BUCKET_NAME: Target bucket name ("Daily Meat").
#    - CLOUDINARY_CLOUD_NAME / CLOUDINARY_API_KEY / CLOUDINARY_API_SECRET: Fallback CDN keys.
# ==============================================================================


# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================

# Server
PORT=5000
APP_BASE_URL=https://dailymeatserver.devmetsolutions.com

# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres.<project_id>:<password>@<host>:6543/postgres

# Cashfree Payments
CASHFREE_ENV=PROD
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key

# Authentication & JWT Secrets
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=50d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
REFRESH_TOKEN_EXPIRES_IN=50d

# Firebase Push Notifications
FIREBASE_SERVICE_ACCOUNT_BASE64=your_base64_encoded_firebase_service_account_json

# Email (Zoho SMTP)
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_USER=noreply@dailymeat.in
SMTP_PASS=your_smtp_password
SMTP_FROM="Daily Meat" <noreply@dailymeat.in>

# SMS Fortius
SMS_FORTIUS_API_KEY=your_sms_fortius_api_key
SMS_FORTIUS_SENDER_ID=DMMEAT
SMS_FORTIUS_TEMPLATE_ID=your_dlt_template_id
SMS_FORTIUS_BASE_URL=https://smsfortius.org/V2/apikey.php

# Google Geocoding (pins the delivery location from the typed address; enable "Geocoding API")
# Without it, falls back to OpenStreetMap which is often only street/area accurate in India.
# GOOGLE_MAPS_API_KEY=your_google_maps_geocoding_api_key

# Optional: Android notification channel id (created in the app with high importance + alert sound)
ANDROID_NOTIFICATION_CHANNEL_ID=orders

# Storage Provider ('s3' or 'cloudinary')
STORAGE_PROVIDER=s3

# S3 Configuration (Supabase S3 Protocol)
AWS_REGION=ap-southeast-1
AWS_ENDPOINT=https://<project_id>.supabase.co/storage/v1/s3
AWS_ACCESS_KEY_ID=your_s3_access_key_id
AWS_SECRET_ACCESS_KEY=your_s3_secret_access_key
AWS_S3_BUCKET_NAME="Daily Meat"

# Cloudinary (Fallback)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
