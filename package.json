{
  "name": "daily-meat-be",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:sync": "node src/scripts/syncDb.js",
    "setup:admin": "node src/scripts/setupAdmin.js",
    "logout:admins": "node src/scripts/logoutAdmins.js",
    "test:s3": "node src/scripts/testS3.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "db:up": "docker compose --env-file infra/compose.env up -d",
    "db:down": "docker compose --env-file infra/compose.env down",
    "db:reset": "docker compose --env-file infra/compose.env down -v && docker compose --env-file infra/compose.env up -d",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:status": "sequelize-cli db:migrate:status",
    "db:migrate:create": "sequelize-cli migration:generate",
    "db:export": "sh infra/export-data.sh",
    "db:import": "sh infra/import-data.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "bcrypt": "^6.0.0",
    "cloudinary": "^1.41.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "expo-server-sdk": "^6.1.0",
    "express": "^5.2.1",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.3",
    "moment-timezone": "^0.6.2",
    "multer": "^2.1.1",
    "multer-s3": "^3.0.1",
    "multer-storage-cloudinary": "^4.0.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.11",
    "pg": "^8.21.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5"
  }
}
